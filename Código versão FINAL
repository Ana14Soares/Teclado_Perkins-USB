#include "USB.h"
#include "USBHIDKeyboard.h"
#include "DFRobotDFPlayerMini.h"
#include <HardwareSerial.h>

// Inicializa o objeto teclado
USBHIDKeyboard Keyboard;
DFRobotDFPlayerMini myDFPlayer;
HardwareSerial dfSerial(1);

#define DF_RX 40 
#define DF_TX 39 
// Definição dos pinos Braille (Pontos 1 a 6)
const int pino_b1 = 18; // Ponto 1
const int pino_b2 = 7; // Ponto 2
const int pino_b3 = 6; // Ponto 3
const int pino_b4 = 17; // Ponto 4
const int pino_b5 = 8;  // Ponto 5
const int pino_b6 = 9;  // Ponto 6

// Definição dos pinos das Teclas de Função
const int pEnter      = 5; // Pino do botão Enter
const int pEspaco     = 15; // Pino do botão Espaço (além do ponto Braille)
const int pDelete     = 37;  // Pino do botão Delete/Backspace
const int pino_numero = 4;  // Mantido pino 8 para o modo numérico (se for usado)

// NOVO PINO PARA O SHIFT FIXO/PEGAJOSO
const int pino_shift_latch = 36;
const int seta_dir = 48;
const int seta_esq = 47;
const int seta_up = 21;
const int seta_down = 35; 

// Array para facilitar o acesso aos pinos Braille
const int PINOS_BRAILLE[6] = {pino_b1, pino_b2, pino_b3, pino_b4, pino_b5, pino_b6};

// Variáveis de controle de estado
bool bufferAtivo = false;
unsigned long tempoInicio = 0;
const unsigned long TEMPO_ESPERA         = 300; 
const unsigned long DEBOUNCE_DELAY       = 50;
const unsigned long TEMPO_ESPERA_NUMERO  = 500;
const unsigned long TEMPO_ESPERA_MAIUSCULO = 600;

int buffer[6]          = {HIGH, HIGH, HIGH, HIGH, HIGH, HIGH};
int leituraAnterior[6] = {HIGH, HIGH, HIGH, HIGH, HIGH, HIGH};

// Controle de modo
bool modoNumero = false;
bool modoMaiusculo = false;
bool preModoMaiusculo = false;
bool modoMaiusculoFixo = false;
// NOVO: Modo Shift (ativado por clique, desativado após 1 caractere)
bool modoShift = false; 

// Protótipos
void limparBuffer();
void aguardarSoltarBotoes();
void processarBuffer();
void ativarModoNumero();
void ativarModoMaiusculo();
void ativarModoShift(); // NOVO PROTÓTIPO
void processarBufferMaiusculo(bool b1, bool b2, bool b3, bool b4, bool b5, bool b6);
void processarBufferNumero(bool b1, bool b2, bool b3, bool b4, bool b5, bool b6);
void processarBufferShift(bool b1, bool b2, bool b3, bool b4, bool b5, bool b6);
// Funções que usam o pino 8 precisam ser renomeadas no código se você quiser usá-lo para outra coisa.
// Mantendo pino_numero = 8 para compatibilidade com o modo numérico Braille.

// ===== SETUP =====
void setup() {
    Keyboard.begin();
    USB.begin();
    dfSerial.begin(9600, SERIAL_8N1, DF_RX, DF_TX);
    delay(1000);

    // Pinos Braille com pull-up interno
    for (int i = 0; i < 6; i++) {
        pinMode(PINOS_BRAILLE[i], INPUT_PULLUP);
    }

    if (!myDFPlayer.begin(dfSerial)) {
    
  } else {

    myDFPlayer.volume(30); 
  }
    // Funções + botões de Modo
    pinMode(pEnter,         INPUT_PULLUP);
    pinMode(pEspaco,        INPUT_PULLUP);
    pinMode(pDelete,        INPUT_PULLUP);
    pinMode(seta_up,        INPUT_PULLUP);
    pinMode(seta_down,       INPUT_PULLUP);
    pinMode(seta_dir,       INPUT_PULLUP);
    pinMode(seta_esq,       INPUT_PULLUP);
    pinMode(pino_numero,    INPUT_PULLUP);
    pinMode(pino_shift_latch, INPUT_PULLUP); // NOVO PINO
}

// ===== LOOP =====
void loop() {
    // 1. Botões de função – prioridade máxima
    if (digitalRead(pDelete) == LOW) {
        Keyboard.write(KEY_BACKSPACE);
        myDFPlayer.playFolder(4, 4);
        while (digitalRead(pDelete) == LOW) { delay(10); }
        delay(DEBOUNCE_DELAY);
        return;
    }

    if (digitalRead(seta_up) == LOW) {
        Keyboard.write(KEY_UP_ARROW);
        myDFPlayer.playFolder(4, 5);
        while (digitalRead(seta_up) == LOW) delay(10);
        delay(DEBOUNCE_DELAY);
        return;
  }

    if (digitalRead(seta_down) == LOW) {
        Keyboard.write(KEY_DOWN_ARROW);
        myDFPlayer.playFolder(4, 6);
        while (digitalRead(seta_down) == LOW) delay(10);
        delay(DEBOUNCE_DELAY);
        return;
    }

    if (digitalRead(seta_esq) == LOW) {
        Keyboard.write(KEY_LEFT_ARROW);
        myDFPlayer.playFolder(4, 7);

while (digitalRead(seta_esq) == LOW) delay(10);
        delay(DEBOUNCE_DELAY);
        return;
    }

    if (digitalRead(seta_dir) == LOW) {
        Keyboard.write(KEY_RIGHT_ARROW);
        myDFPlayer.playFolder(4, 8);
        while (digitalRead(seta_dir) == LOW) delay(10);
        delay(DEBOUNCE_DELAY);
        return;
    }

    if (digitalRead(pEnter) == LOW) {
        Keyboard.write(KEY_RETURN);
        myDFPlayer.playFolder(4, 9);
        while (digitalRead(pEnter) == LOW) { delay(10); }
        delay(DEBOUNCE_DELAY);
        return;
    }

    // Lógica de desativação do Caps Lock pelo Espaço
    if (digitalRead(pEspaco) == LOW) {
        if (modoMaiusculoFixo) {
            modoMaiusculoFixo = false; // Desliga Caps Lock
        } else {
            Keyboard.write(' ');
            myDFPlayer.playFolder(4, 10);
        }
        while (digitalRead(pEspaco) == LOW) { delay(10); }
        delay(DEBOUNCE_DELAY);
        return;
    }

    //  ATIVAÇÃO DO MODO SHIFT PELO PINO DEDICADO
    if (digitalRead(pino_shift_latch) == LOW) {
        ativarModoShift();
        // Espera soltar o botão Shift
        while (digitalRead(pino_shift_latch) == LOW) { delay(10); } 
        delay(DEBOUNCE_DELAY);
        return;
    }
    
    // 2. Leitura dos botões Braille
    int leituraAtual[6];
    bool algumPressionado      = false;
    bool novasTeclasDetectadas = false;
    
    for (int i = 0; i < 6; i++) {
        leituraAtual[i] = digitalRead(PINOS_BRAILLE[i]);
        if (leituraAtual[i] == LOW) {
            algumPressionado = true;
        }
    }

    // Combinações de ativação de modo (Prefixos Braille)
    
    // Combinação MODO NÚMERO: 001111 (b3,b4,b5,b6)
    bool combinacaoNumeroPressionada =
        (leituraAtual[0] == HIGH && leituraAtual[1] == HIGH &&  
         leituraAtual[2] == LOW  && leituraAtual[3] == LOW  &&  
         leituraAtual[4] == LOW  && leituraAtual[5] == LOW);    

    // Combinação MODO MAIÚSCULO: 000101 (b4,b6)
    bool combinacaoMaiusculoPressionada =
        (leituraAtual[0] == HIGH && leituraAtual[1] == HIGH &&  
         leituraAtual[2] == HIGH && leituraAtual[3] == LOW  &&  
         leituraAtual[4] == HIGH && leituraAtual[5] == LOW);    

    // ATIVAÇÃO DO MODO NÚMERO (botão físico ou prefixo Braille)
    if (digitalRead(pino_numero) == LOW || combinacaoNumeroPressionada) {
        ativarModoNumero();
        if (digitalRead(pino_numero) == LOW) {
            while (digitalRead(pino_numero) == LOW) { delay(10); }
        }
        if (combinacaoNumeroPressionada) {
            aguardarSoltarBotoes();
        }
        delay(DEBOUNCE_DELAY);
        return;
    }

    // ATIVAÇÃO DO MODO MAIÚSCULO (Caps Lock)
    if (combinacaoMaiusculoPressionada) {
        ativarModoMaiusculo();
        aguardarSoltarBotoes();
        delay(DEBOUNCE_DELAY);
        return;
    }

    // 3. Detecção de novas teclas (para controle de tempo)
    for (int i = 0; i < 6; i++) {
        if (leituraAtual[i] == LOW && leituraAnterior[i] == HIGH) {
            novasTeclasDetectadas = true;
        }
    }

    // 4. Gerenciamento do buffer
    if (algumPressionado && !bufferAtivo) {
        bufferAtivo   = true;
        tempoInicio   = millis();
        limparBuffer();
    }

    if (bufferAtivo) {
        // Guarda no buffer quais pontos foram pressionados
        for (int i = 0; i < 6; i++) {
            if (leituraAtual[i] == LOW) {
                buffer[i] = LOW;
            }
        }

        if (novasTeclasDetectadas) {
            tempoInicio = millis();
        }

        // Escolhe tempo de espera de acordo com o modo
        unsigned long tempoLimite;
        if (modoNumero) {
            tempoLimite = TEMPO_ESPERA_NUMERO;
        } else if (modoMaiusculomodoMaiusculoFixo || modoShift) {
            // Usa o tempo maior se estiver em qualquer modo especial
            tempoLimite = TEMPO_ESPERA_MAIUSCULO;
        } else {
            tempoLimite = TEMPO_ESPERA;
        }

        // Quando o tempo expira, processa a combinação

if (millis() - tempoInicio >= tempoLimite) {
            processarBuffer();
            aguardarSoltarBotoes();
            bufferAtivo = false;
            limparBuffer();

            // Lógica de desativação de modos de 1 toque (Sticky Mode)
            if (modoNumero) {
                modoNumero = false;
            }

            if (modoMaiusculo && !modoMaiusculoFixo) {
                modoMaiusculo = false;
            }

            if (preModoMaiusculo) {
                preModoMaiusculo = false;
            }
            
            //  DESATIVA O MODO SHIFT APÓS UMA COMBINAÇÃO SER PROCESSADA
            if (modoShift) {
                modoShift = false;
            }
        }
    }

    // 5. Atualiza estados anteriores
    for (int i = 0; i < 6; i++) {
        leituraAnterior[i] = leituraAtual[i];
    }

    delay(10);
}

// ===== FUNÇÕES AUXILIARES DE ATIVAÇÃO =====

// NOVO: Ativa o modo Shift Fixo/Pegajoso (Sticky)
void ativarModoShift() {
    modoShift = !modoShift; // Alterna (liga/desliga)
    bufferAtivo = false;
    limparBuffer();
    myDFPlayer.playFolder(4, 3);
}

void ativarModoNumero() {
    modoNumero   = !modoNumero;
    bufferAtivo  = false;
    limparBuffer();
    myDFPlayer.playFolder(4, 2);
    
}

void ativarModoMaiusculo() {
    if (preModoMaiusculo) {
        modoMaiusculoFixo = true; 
        preModoMaiusculo = false;
    } else if (modoMaiusculoFixo) {
        modoMaiusculoFixo = false;
    } else {
        preModoMaiusculo = true;
    }
    bufferAtivo  = false;
    limparBuffer();
    myDFPlayer.playFolder(4, 1);
}

void limparBuffer() {
    for (int i = 0; i < 6; i++) {
        buffer[i] = HIGH;
    }
}

void aguardarSoltarBotoes() {
    for (int i = 0; i < 6; i++) {
        while (digitalRead(PINOS_BRAILLE[i]) == LOW) {
            delay(10);
            i = -1; 
        }
    }
    // Aguarda soltar o botão Shift Latch se ele estiver pressionado
    while (digitalRead(pino_shift_latch) == LOW) {
        delay(10);
    }
    
    // Aguarda soltar o botão Número se ele estiver pressionado
    while (digitalRead(pino_numero) == LOW) {
        delay(10);
    }
    
    delay(DEBOUNCE_DELAY);
}

// ===== PROCESSAMENTO PRINCIPAL (Decisão de Modo) =====
void processarBuffer() {
    bool b1 = (buffer[0] == LOW);
    bool b2 = (buffer[1] == LOW);
    bool b3 = (buffer[2] == LOW);
    bool b4 = (buffer[3] == LOW);
    bool b5 = (buffer[4] == LOW);
    bool b6 = (buffer[5] == LOW);

    // 1) Modo Número
    if (modoNumero) {
        processarBufferNumero(b1, b2, b3, b4, b5, b6);
        return;
    }
    
    //  2) Modo SHIFT (Ativado se modoShift for true)
    if (modoShift) {
        processarBufferShift(b1, b2, b3, b4, b5, b6);
        return;
    }

    // 3) Modo Maiúsculo Fixo ou Pré-Maiúsculo
    bool deveSerMaiusculo = modoMaiusculoFixo || preModoMaiusculo;

    if (deveSerMaiusculo) {
        processarBufferMaiusculo(b1, b2, b3, b4, b5, b6);
        return;
    }

    // 4) Modo normal – letras minúsculas e sinais
    char letra = '\0';
