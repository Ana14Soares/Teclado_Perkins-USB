    // Q = 111110
    else if (b1 && b2 && b3 && b4 && b5 && !b6) { letra_maiuscula = 'Q'; audio = 17;}
    // R = 111010
    else if (b1 && b2 && b3 && !b4 && b5 && !b6) { letra_maiuscula = 'R'; audio = 18;}
    // S = 011100
    else if (!b1 && b2 && b3 && b4 && !b5 && !b6) { letra_maiuscula = 'S'; audio = 19;}
    // T = 011110
    else if (!b1 && b2 && b3 && b4 && b5 && !b6) { letra_maiuscula = 'T'; audio = 20;}
    // U = 101001
    else if (b1 && !b2 && b3 && !b4 && !b5 && b6) { letra_maiuscula = 'U'; audio = 21;}
    // V = 111001
    else if (b1 && b2 && b3 && !b4 && !b5 && b6) { letra_maiuscula = 'V'; audio = 22;}
    // W = 010111
    else if (!b1 && b2 && !b3 && b4 && b5 && b6) { letra_maiuscula = 'W'; audio = 23;}
    // X = 101101
    else if (b1 && !b2 && b3 && b4 && !b5 && b6) { letra_maiuscula = 'X'; audio = 24;}
    // Y = 101111
    else if (b1 && !b2 && b3 && b4 && b5 && b6) { letra_maiuscula = 'Y'; audio = 25;}
    // Z = 101011
    else if (b1 && !b2 && b3 && !b4 && b5 && b6) { letra_maiuscula = 'Z'; audio = 26;}

    if (letra_maiuscula != '\0') {
        Keyboard.write(letra_maiuscula);
        if (audio > 0) {
          myDFPlayer.playFolder(1, audio);
        }
    } else {
        processarBuffer(); 
        return;
    }
}


// ===== PROCESSAMENTO SHIFT (Ajustado para sair ":" corretamente) =====
void processarBufferShift(bool b1, bool b2, bool b3, bool b4, bool b5, bool b6) {
    char caractere_base = '\0';
    int audio = 0;
    bool usarShift = true; 

    // ! (Shift + 1)
    if (b1 && !b2 && !b3 && !b4 && !b5 && !b6) { caractere_base = '1'; audio = 1; }
    
    // @ (Shift + 2)
    else if (b1 && b2 && !b3 && !b4 && !b5 && !b6) { caractere_base = '2'; audio = 2; }
    
    // # (Shift + 3)
    else if (b1 && !b2 && !b3 && b4 && !b5 && !b6) { caractere_base = '3'; audio = 3; }
    
    // $ (Shift + 4)
    else if (b1 && !b2 && !b3 && b4 && b5 && !b6) { caractere_base = '4'; audio = 4; }
    
    // % (Shift + 5)
    else if (b1 && !b2 && !b3 && !b4 && b5 && !b6) { caractere_base = '5'; audio = 5; } 

    // * (Shift + 8)
    else if (b1 && b2 && !b3 && !b4 && b5 && !b6) { caractere_base = '8'; audio = 6; }
    
    // : (Dois Pontos) -> Mudado para ';' para garantir o ":" no terminal
    else if (b1 && !b2 && b3 && !b4 && !b5 && !b6) { caractere_base = ';' ; audio = 7; }

    // + (Shift + =)
    else if (b1 && b2 && !b3 && b4 && b5 && !b6) { caractere_base = '='; audio = 8; }

    // . (Ponto Final) -> Braille Ponto 3
    else if (!b1 && !b2 && b3 && !b4 && !b5 && !b6) { 
        caractere_base = '.'; 
        audio = 9; 
        usarShift = false; 
    }

    else {
        caractere_base = '\0'; 
    }

    if (caractere_base != '\0') {

if (usarShift) {
            Keyboard.press(KEY_LEFT_SHIFT);
            Keyboard.write(caractere_base);
            Keyboard.releaseAll();
        } else {
            Keyboard.write(caractere_base);
        }

        if (audio > 0) {
            myDFPlayer.playFolder(3, audio);
        }
    }
}
