    // F = 110100
    else if (b1 && b2 && !b3 && b4 && !b5 && !b6) { letra = 'f'; audio  = 6; }
    // G = 110110
    else if (b1 && b2 && !b3 && b4 && b5 && !b6) { letra = 'g'; audio = 7; }
    // H = 110010
    else if (b1 && b2 && !b3 && !b4 && b5 && !b6) { letra = 'h'; audio = 8; }
    // I = 010100
    else if (!b1 && b2 && !b3 && b4 && !b5 && !b6) { letra = 'i'; audio = 9; }
    // J = 010110

else if (!b1 && b2 && !b3 && b4 && b5 && !b6) { letra = 'j'; audio = 10; }
    // K = 101000
